"""Answerability detection: decide whether the retrieved evidence is strong enough to answer at all.

Method (deliberately simple and inspectable): take the strongest retrieval signal for the question, e.g. the top-1
cosine similarity of a dense retriever, or the top-1 BM25 score, and answer only if it reaches a threshold that was
fitted on a development split (maximising F1 for the ANSWERABLE class).  There is one threshold per retrieval method,
because the score types (BM25, cosine, RRF) live on different scales.

Limits: the signal measures lexical or semantic closeness, not whether the passage actually contains the answer, so a
topically related passage can pass the gate; E5 cosines are compressed into a narrow band, so the threshold is
sensitive; and thresholds fitted on a few dozen questions are unstable.
"""
from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from app import config
from app.evalkit import confusion

THRESHOLDS_PATH = config.REPORTS_DIR / "answerability_thresholds.json"
SIGNAL_TYPES = {"bm25": "bm25_top1", "pretrained": "cosine_top1", "hybrid": "dense_cosine_top1"}


def evidence_signal(method: str, results: list[dict[str, Any]]) -> float | None:
    """Strongest relevance signal in the result list, or None when it cannot be computed."""
    if method == "bm25":
        return float(results[0]["score"]) if results else 0.0
    if method == "pretrained":
        return float(results[0]["score"]) if results else None
    if method == "hybrid":
        dense = [r["dense_top1"] for r in results if r.get("dense_top1") is not None]
        dense += [r["dense_score"] for r in results if r.get("dense_score") is not None]
        return float(max(dense)) if dense else None
    raise ValueError(f"Unknown method {method}")


def fit_threshold(signals: list[float], answerable: list[bool]) -> dict[str, Any]:
    """Pick the threshold t (predict ANSWERABLE iff signal >= t) that maximises F1 of the ANSWERABLE class on the
    given data. Ties are broken by accuracy, then by the HIGHER threshold (more conservative)."""
    if not signals or len(signals) != len(answerable):
        raise ValueError("signals and labels must be non-empty and the same length")
    vals = sorted(set(signals))
    candidates = [vals[0] - 1e-6] + [(a + b) / 2 for a, b in zip(vals, vals[1:])] + [vals[-1] + 1e-6]
    best: tuple[float, float, float] | None = None
    for t in candidates:
        m = confusion(answerable, [s >= t for s in signals])
        key = (m["f1"], m["accuracy"], t)
        if best is None or key > best:
            best = key
    assert best is not None
    t = best[2]
    fit = confusion(answerable, [s >= t for s in signals])
    return {"threshold": round(t, 6), "fit_n": len(signals),
            **{f"fit_{k}": fit[k] for k in ("f1", "accuracy", "precision", "recall")}}


def auc(signals: list[float], answerable: list[bool]) -> float | None:
    """Threshold-free ROC-AUC (probability a random answerable question outscores a random unanswerable one)."""
    pos = [s for s, a in zip(signals, answerable) if a]
    neg = [s for s, a in zip(signals, answerable) if not a]
    if not pos or not neg:
        return None
    wins = sum((p > n) + 0.5 * (p == n) for p in pos for n in neg)
    return round(wins / (len(pos) * len(neg)), 4)


_cache: dict[str, Any] = {"mtime": None, "path": None, "data": {}}


def load_thresholds(path: Path | None = None) -> dict[str, Any]:
    path = path or THRESHOLDS_PATH
    if not path.exists():
        return {}
    mtime = path.stat().st_mtime
    if _cache["path"] != str(path) or _cache["mtime"] != mtime:
        _cache.update(path=str(path), mtime=mtime, data=json.loads(path.read_text(encoding="utf-8")))
    return _cache["data"]


def assess(method: str, results: list[dict[str, Any]], thresholds: dict[str, Any] | None = None) -> dict[str, Any]:
    """Answerability decision for one question. Status is one of answerable / unanswerable / not_calibrated."""
    thresholds = load_thresholds() if thresholds is None else thresholds
    signal = evidence_signal(method, results)
    entry = thresholds.get(method)
    base = {"signal": None if signal is None else round(signal, 6), "signal_type": SIGNAL_TYPES[method],
            "threshold": None if not entry else entry["threshold"]}
    if not entry:
        return {**base, "status": "not_calibrated",
                "reason": f"No answerability threshold has been fitted for '{method}'. "
                          "Run backend/evaluate_answerability.py to calibrate it; until then no question is rejected."}
    if signal is None:
        return {**base, "status": "unanswerable", "reason": "No usable relevance signal was produced for this question."}
    ok = signal >= entry["threshold"]
    return {**base, "status": "answerable" if ok else "unanswerable",
            "reason": (f"Top evidence signal {signal:.3f} {'meets' if ok else 'is below'} the calibrated threshold "
                       f"{entry['threshold']:.3f} ({SIGNAL_TYPES[method]}). Fitted on {entry.get('fit_n', '?')} "
                       f"{entry.get('fit_split', 'dev')} questions; a heuristic, not a probability.")}
"""Optional multilingual lexical expansion for English-document retrieval.

For research transparency this uses a small editable dictionary, not a machine translation model.
Dense E5 remains the intended cross-lingual baseline. Expanded query is only used for BM25/hybrid lexical leg.
"""
import re

LEXICON = {
 "scholarship": ["छात्रवृत्ति", "scholarship"], "eligibility": ["पात्रता", "eligible"],
 "minimum attendance": ["न्यूनतम उपस्थिति", "attendance"], "attendance": ["उपस्थिति", "minimum attendance"],
 "exam": ["परीक्षा", "examination"], "examination": ["परीक्षा", "exam"], "refund": ["वापसी", "refund"],
 "fee": ["शुल्क", "fees"], "fees": ["शुल्क", "fee"], "credit": ["क्रेडिट", "credits"],
 "credits": ["क्रेडिट", "credit"], "semester": ["सेमेस्टर", "term"], "marks": ["अंक", "marks"],
 "cgpa": ["सीजीपीए", "grade point"], "grading": ["ग्रेड", "grade"],
 "leave": ["छुट्टी", "absence"], "absence": ["अनुपस्थिति", "leave"],
 "btech": ["बीटेक", "b.tech"], "student": ["छात्र", "student"], "students": ["छात्र", "student"],
}

def expand_query(query: str) -> str:
    q=(query or "").strip(); low=q.lower(); extras=[]
    for key, vals in LEXICON.items():
        if key in low or key in q or any(v in q for v in vals):
            extras.extend(v for v in vals if v.lower() not in low)
    # Avoid over-expanded strings: add at most 6 unique tokens/phrases.
    extras=list(dict.fromkeys(extras))[:6]
    return q + (" " + " ".join(extras) if extras else "")
"""Feature 2 - answerability detection.

Fits one threshold per retrieval method on the DEV split, then reports accuracy / precision / recall / F1 and the
confusion matrix on the untouched TEST split (positive class = ANSWERABLE). Writes
  reports/answerability_thresholds.json  (read by /ask)   and   reports/answerability_eval.json

Usage:  python backend/evaluate_answerability.py [--methods bm25 hybrid ...]
"""
import argparse

from eval_common import ALL_METHODS, make_retrieve, method_status, write_json
from app.evalkit import load_dataset
from app.qa_eval import answerability_report, collect_signals


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--methods", nargs="+", default=ALL_METHODS, choices=ALL_METHODS)
    a = ap.parse_args()
    dev, test = load_dataset(split="dev"), load_dataset(split="test")
    retrieve = make_retrieve()
    usable, skipped = method_status(a.methods)
    thresholds, evals = {}, {}
    for m in usable:
        entry, ev = answerability_report(dev, collect_signals(dev, retrieve, m), test, collect_signals(test, retrieve, m), m)
        thresholds[m], evals[m] = entry, ev
        t = ev["test"]["overall"]
        print(f"{m:11} thr={entry['threshold']:.4f}  test acc={t['accuracy']:.2f} P={t['precision']:.2f} "
              f"R={t['recall']:.2f} F1={t['f1']:.2f} AUC={ev['test']['auc']}  confusion tp/fp/tn/fn="
              f"{t['tp']}/{t['fp']}/{t['tn']}/{t['fn']}")
    for m, why in skipped.items():
        print(f"{m:11} SKIPPED: {why}")
    write_json("answerability_thresholds.json", thresholds)
    write_json("answerability_eval.json", {
        "protocol": "threshold fitted on dev, scored on test; positive class = answerable",
        "dev_questions": len(dev), "test_questions": len(test),
        "caveat": "Questions are AI-drafted and not yet human-verified; with ~30 test questions per class the "
                  "numbers are indicative only.",
        "methods": evals, "skipped": skipped})


if __name__ == "__main__":
    main()
